# mongodb
# mongodb uri
URI=mongodb://localhost:27017/
# mongodb database name
DATABASE=demo

# Cloudinary
# Cloudinary name
CLOUDINARY_NAME=
# Cloudinary api key
CLOUDINARY_API_KEY=
# Cloudinary api secret
CLOUDINARY_API_SECRET=
# Cloudinary upload base folder
CLOUDINARY_BASE_FOLDER=

## administrator
ADMIN_EMAIL=

# Google Gemini
# API key from Google AI Studio
GEMINI_API_KEY=
# Optional: override model name for image-to-video generation
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
# Optional: API version for video generation endpoints
GEMINI_API_VERSION=v1alpha